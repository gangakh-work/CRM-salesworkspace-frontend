VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Expose an API scope from the Entra app registration for the FastAPI backend
VITE_MSAL_API_SCOPE=api://YOUR_BACKEND_APP_CLIENT_ID/access_as_user

# Add after admin consent is granted for Microsoft Graph calendar access
VITE_MS_GRAPH_SCOPES=Calendars.ReadWrite
