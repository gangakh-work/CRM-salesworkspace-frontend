# Application
VITE_APP_NAME=Sales Workspace
VITE_APP_VERSION=0.1.0
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Microsoft Entra ID sign-in — see ENTRA_SETUP.md (set VITE_ENABLE_MOCK_AUTH=false to use it)
# VITE_MSAL_API_SCOPE example: api://<client-id>/access_as_user
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
VITE_MSAL_REDIRECT_URI=http://localhost:5173
VITE_MSAL_API_SCOPE=

# Development
VITE_ENABLE_MOCK_AUTH=false

# Optional welcome-page hero video (mp4/webm). Leave empty to use the poster image.
VITE_WELCOME_VIDEO_URL=
# Optional hero poster image (defaults to /images/login-hero-bg.png, shown in black & white).
VITE_WELCOME_VIDEO_POSTER=

# Required for production Microsoft sign-in:
# VITE_MSAL_CLIENT_ID=<Application (client) ID of the SPA registration>
# VITE_MSAL_TENANT_ID=<Directory (tenant) ID>
# VITE_MSAL_REDIRECT_URI=http://localhost:5173
# VITE_MSAL_API_SCOPE=api://<API-app-client-id>/access_as_user
